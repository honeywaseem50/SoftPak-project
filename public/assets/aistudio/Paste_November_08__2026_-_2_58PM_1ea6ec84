<script>
  // Dynamic Key Counter and Input Sanitization
  const keysTextarea = document.getElementById('keys-input');
  const keyCountDisplay = document.getElementById('key-count-display');
  const clearKeysBtn = document.getElementById('clear-keys-btn');
  const uploadTrigger = document.getElementById('upload-trigger');
  const keysFileInput = document.getElementById('keys-file-input');
  const toastNotification = document.getElementById('toast-notification');
  const toastClose = document.getElementById('toast-close');
  const publishBtn = document.getElementById('publish-btn');
  const draftBtn = document.getElementById('draft-btn');

  function updateKeyCount() {
    if (!keysTextarea || !keyCountDisplay) return;
    const lines = keysTextarea.value
      .split('\n')
      .map(k => k.trim())
      .filter(k => k.length > 0);
    const count = lines.length;
    keyCountDisplay.textContent = count === 1 ? '1 key detected' : count + ' keys detected';
  }

  if (keysTextarea) {
    keysTextarea.addEventListener('input', updateKeyCount);
  }

  if (clearKeysBtn && keysTextarea) {
    clearKeysBtn.addEventListener('click', () => {
      keysTextarea.value = '';
      updateKeyCount();
    });
  }

  // Duration Pill selector interaction
  const durationPills = document.querySelectorAll('.duration-pill');
  durationPills.forEach(pill => {
    pill.addEventListener('click', () => {
      durationPills.forEach(p => {
        p.classList.remove('bg-surface-container-high', 'text-secondary', 'shadow-sm');
        p.classList.add('text-on-surface-variant');
      });
      pill.classList.remove('text-on-surface-variant');
      pill.classList.add('bg-surface-container-high', 'text-secondary', 'shadow-sm');
      const radio = pill.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
    });
  });

  // Simulated File Upload Handling
  if (uploadTrigger && keysFileInput) {
    uploadTrigger.addEventListener('click', () => keysFileInput.click());
    keysFileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        const content = event.target.result;
        keysTextarea.value = content;
        updateKeyCount();
        showToast('File Imported', file.name + ' loaded into editor.');
      };
      reader.readAsText(file);
    });
  }

  // Toast Functionality
  function showToast(title, msg) {
    if (!toastNotification) return;
    document.getElementById('toast-title').textContent = title;
    document.getElementById('toast-desc').textContent = msg;
    toastNotification.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    toastNotification.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      hideToast();
    }, 4000);
  }

  function hideToast() {
    if (!toastNotification) return;
    toastNotification.classList.remove('translate-y-0', 'opacity-100');
    toastNotification.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
  }

  if (toastClose) {
    toastClose.addEventListener('click', hideToast);
  }

  if (publishBtn) {
    publishBtn.addEventListener('click', () => {
      showToast('Software Published!', 'Keys active for instant WhatsApp delivery.');
