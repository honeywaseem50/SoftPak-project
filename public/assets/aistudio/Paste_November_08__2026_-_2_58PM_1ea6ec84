<script>
  (function initAdminInteractions() {
    const sheet = document.getElementById('licenseBatchSheet');
    const closeBtn = document.getElementById('closeBatchSheet');
    const rawInput = document.getElementById('rawKeyInput');
    const countDisplay = document.getElementById('detectedKeysCount');
    const targetLabel = document.getElementById('targetSkuLabel');
    const confirmBtn = document.getElementById('confirmInjectBtn');

    window.triggerKeyInjection = function(sku) {
      if (targetLabel) targetLabel.textContent = 'SKU: ' + sku;
      if (rawInput) rawInput.value = '';
      if (countDisplay) countDisplay.textContent = '0 detected';
      sheet.classList.remove('opacity-0', 'pointer-events-none');
      sheet.classList.add('opacity-100', 'pointer-events-auto');
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        sheet.classList.add('opacity-0', 'pointer-events-none');
        sheet.classList.remove('opacity-100', 'pointer-events-auto');
      });
    }

    if (rawInput) {
      rawInput.addEventListener('input', function(e) {
        const lines = e.target.value.split('\n').filter(line => line.trim().length > 5);
        if (countDisplay) {
          countDisplay.textContent = lines.length + ' detected';
        }
      });
    }

    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">sync</span><span>Syncing Vault...</span>';
        setTimeout(() => {
          confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check</span><span>Vault Updated!</span>';
          setTimeout(() => {
            sheet.classList.add('opacity-0', 'pointer-events-none');
            sheet.classList.remove('opacity-100', 'pointer-events-auto');
            confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]">cloud_upload</span><span>Encrypt &amp; Add to Vault</span>';
          }, 800);
        }, 1000);
      });
    }

    // Modal trigger for top Add button
    const openNewBtn = document.getElementById('openNewSoftwareModal');
    if (openNewBtn) {
      openNewBtn.addEventListener('click', function() {
        window.triggerKeyInjection('SB-NEW-CATALOG-SKU');
      });
    }

    // Search filter micro-behavior
    const searchInput = document.getElementById('adminSearchInput');
    const items = document.querySelectorAll('#inventoryItemsContainer > div');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase();
        items.forEach(item => {
          const text = item.innerText.toLowerCase();
          item.style.display = text.includes(query) ? 'flex' : 'none';
        });
      });
    }
  })();
