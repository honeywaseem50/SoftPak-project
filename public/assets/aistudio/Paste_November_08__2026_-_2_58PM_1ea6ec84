        productCards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category-item') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Search filter
    const searchInput = document.getElementById('softwareSearchInput');
    if (searchInput) {
