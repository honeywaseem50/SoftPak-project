  function copyToClipboard(text, btnElement) {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text);
    } else {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.left = '-9999px';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }

    if (navigator.vibrate) {
      navigator.vibrate(30);
    }

    // Button state transformation
    const originalContent = btnElement.innerHTML;
    btnElement.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span><span>Copied</span>';
    btnElement.classList.add('bg-secondary', 'text-on-secondary');

    // Visual Toast Display
    const toast = document.getElementById('toast');
    if (toast) {
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2200);
    }

    setTimeout(() => {
      btnElement.innerHTML = originalContent;
      btnElement.classList.remove('bg-secondary', 'text-on-secondary');
    }, 1800);
  }

